# === JARVIS Konfiguration ===
# Kopieren nach .env und ausfuellen. Niemals committen.

# --- Modelle ---------------------------------------------------------------
# Primaer-Modell: kostenlos, stabile Tool-Calling-Qualitaet.
# big-pickle ist ein anonymes Arena-Testmodell: keine Prompt-Caches,
# unvorharsehbare Qualitaet. Nur als Fallback gedacht, nicht als Basis.
LLM_PRIMARY=openrouter/nemotron-3-ultra
LLM_FALLBACKS=openrouter/big-pickle
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
OPENROUTER_API_KEY=

# --- Telegram --------------------------------------------------------------
# Von @BotFather
TELEGRAM_BOT_TOKEN=
# Deine Telegram-User-ID. Alles andere wird ignoriert.
# Erfragen: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALLOWED_USERS=

# --- Web-Chat --------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_AUTH_TOKEN=            # leer lassen = kein Auth. Nur fuer LAN.
WEB_CORS_ORIGINS=

# --- Speicher --------------------------------------------------------------
# Auf dem Host als Volume einhaengen, sonst ist Memory bei CT-Neustart weg.
MEMORY_DB_PATH=/data/memory/jarvis.db
SKILLS_DIR=/data/skills
AUDIO_DIR=/data/audio
LOG_LEVEL=INFO

# --- Limits ----------------------------------------------------------------
# Ganz bewusst klein. Der Host hat 7,6 GB und der CT davon 3 GB.
# Ueberschreitet der Agent eine dieser Schranken, bricht er ab statt
# den Host in den Swap zu treiben.
MAX_TOOL_ROUNDS=12
MAX_TOOL_CALLS=24
MAX_TOOL_OUTPUT_CHARS=8000

AGENT_TIMEOUT_SECONDS=300
SESSION_IDLE_TTL_HOURS=72

# --- Homelab-Tools ---------------------------------------------------------
# Proxmox-API. Leer lassen = Tool meldet sich als deaktiviert.
PROXMOX_HOST=
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=false

# Delegierter Code-Runner. Leer = Ausfuehrung von Code ist deaktiviert.
# Siehe README, Abschnitt "Sandbox". Agent laeuft im CT, Code laeuft
# nicht im Agent-Prozess.
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=

# --- Sprache ---------------------------------------------------------------
# Telegram transkribiert Sprachnachrichten selbst, das kostet dich nichts
# und keine CPU. STT_PROVIDER=groq ist nur fuer das Browser-Live-Mic.
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
TTS_ENABLED=true
TTS_VOICE=de_DE-thorsten-medium
